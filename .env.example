# Server Configuration
CHRONOSAGA_PORT=8080
CHRONOSAGA_HOST=127.0.0.1
CHRONOSAGA_ENVIRONMENT=development
CHRONOSAGA_LOG_LEVEL=info

# PostgreSQL Configuration
DATABASE_URL=postgres://chronosaga:chronosaga_secret@localhost:5432/chronosaga?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Worker Configuration
WORKER_POLL_INTERVAL=500ms
WORKER_CONCURRENCY=5
WORKER_LEASE_DURATION=30s

# Timer Poller Configuration
TIMER_POLL_INTERVAL=200ms
